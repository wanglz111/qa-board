# TestDeck 服务器唯一的配置文件模板：复制为 /home/ubuntu/testdeck/.env 并填入真实值，
# 权限 0600。真实 .env 不进 Git（本仓库是公开仓库）。
#
# 生成密钥：
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -base64 48   # CSRF_SECRET
#   openssl rand -hex 24      # DATABASE_PASSWORD

# ---- 镜像（GitHub Actions 发布到 GHCR，包已设为 public）----
# 发版时只改这两个 tag，然后 docker compose up -d --pull always
WEB_IMAGE=ghcr.io/wanglz111/qa-board-web:v0.1.2
API_IMAGE=ghcr.io/wanglz111/qa-board-api:v0.1.2

# ---- 数据库 ----
DATABASE_PASSWORD=<openssl rand -hex 24>

# ---- 单管理员（ADMIN_PASSWORD 只在第一次启动、还没有管理员时生效）----
ADMIN_EMAIL=lucas.wang21@foxmail.com
ADMIN_PASSWORD=<首次初始化使用的强密码>

# ---- 会话与 CSRF ----
SESSION_SECRET=<openssl rand -base64 48>
CSRF_SECRET=<openssl rand -base64 48>

# ---- Lark 国际版应用凭证 ----
# 只需要应用凭证；执行表与缺陷表由管理员在每个测试组里选择并确认，
# 不再由环境变量指定。
LARK_BASE_URL=https://open.larksuite.com
LARK_APP_ID=<cli_...>
LARK_APP_SECRET=<...>

# ---- Lark 记录里的默认人名（可选）----
# 本工具建出来的表里，负责人/报告人（执行表）与反馈人（缺陷表）都是**人员列**：
# 列里只认 open_id，写不进去就整列省略（留空照样建行）。只有手工建的老表才可能
# 还是文本列，那时才用下面的显示名。
# 设置页（Web：人员设置）保存的值优先于 DEFAULT_REPORTER_ID；环境变量只是
# 「设置页还没配过」时的兜底。文本列留空时负责人用「待指派」、报告人回落到管理员邮箱。
DEFAULT_OWNER=待指派
DEFAULT_REPORTER=Max
# 必须替换：本应用名下的真 open_id（ou_ 加字母数字），姓名/邮箱都不行。
# 下面这行是故意留的**无效占位符**，不替换会被忽略（报告人列留空），而不是发出去被 Lark 拒。
DEFAULT_REPORTER_ID=<替换为本应用名下的真 open_id，占位符本身无效会被忽略>
