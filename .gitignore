# Local configuration and credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Frontend
node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo

# Local runtime data and exports
uploads/
shots/
backups/
# The legacy-attachment disk cache sits beside the screenshots (UPLOAD_DIR's
# parent), so a local run against a real base would otherwise leave untracked
# binaries in the checkout.
lark-attachments/
*.sqlite3
*.db

# Local tooling
.DS_Store
.codegraph/

# Local review work logs (deliverable plans live in docs/superpowers/plans/)
/task_plan.md
/findings.md
/progress.md
# The whole directory is session-local: it carries the per-task working memory
# (task_plan / findings / progress) that the planning-with-files flow writes.
.planning/
