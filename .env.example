# TestDeck 自托管部署模板：复制为 .env，并替换每一个 placeholder。
# 这里的示例值全部不可用，请勿直接用于生产。
#
# 生成密钥（不要把输出提交到 Git 或粘贴到聊天里）：
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -base64 48   # CSRF_SECRET
#   openssl rand -hex 24      # DATABASE_PASSWORD

# ---- 镜像（由 GitHub Actions 发布到 GHCR，需先在 Packages 页面把包设为 public）----
WEB_IMAGE=ghcr.io/wanglz111/qa-board-web:v0.1.0
API_IMAGE=ghcr.io/wanglz111/qa-board-api:v0.1.0

# ---- 数据库 ----
DATABASE_PASSWORD=change-me-database-password

# ---- 单管理员 ----
# ADMIN_PASSWORD 只在第一次启动（还没有管理员时）生效，之后修改这里无效；
# 忘记密码需要直接更新数据库里的 admins.password_hash。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- 会话与 CSRF ----
SESSION_SECRET=change-me-session-secret-please-generate-a-real-one
CSRF_SECRET=change-me-csrf-secret-please-generate-a-real-one

# ---- 域名与证书 ----
# DOMAIN 指向服务器时，代理会自动申请 HTTPS 证书；留空则只提供 HTTP。
DOMAIN=testdeck.example.com
# 只有在本地验证时才需要覆盖对外端口（例如 8081/8443）。
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443

# ---- Lark 国际版（注意是 larksuite，不是 feishu）----
# 应用凭证只用于调用 Lark API；执行表和缺陷表由管理员在每个测试组里
# 选择并确认（页面上的“Lark 检查”），不再由环境变量指定。
LARK_BASE_URL=https://open.larksuite.com
LARK_APP_ID=cli-change-me
LARK_APP_SECRET=change-me-lark-app-secret
